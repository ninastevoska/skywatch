# Application server
APP_HOST=127.0.0.1
APP_PORT=8003

# Named pipe
PIPE_NAME=skywatch_location_finder
PIPE_CONNECT_TIMEOUT=15
PIPE_RESPONSE_TIMEOUT=120
PIPE_RETRY_INTERVAL=0.5
PIPE_MAX_MESSAGE_SIZE=10485760

# Open-Meteo Geocoding API
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1

# OpenRouteService and OpenPoiService
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice/v2
OPS_BASE_URL=https://api.heigit.org/openpoiservice/v0

# External API settings
HTTP_TIMEOUT=15

# Location discovery limits
POI_MAX_AREA_KM2=50
POI_MAX_REQUESTS=30
POI_MAX_CANDIDATES=500